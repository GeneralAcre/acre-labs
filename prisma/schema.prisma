generator client {
  provider = "prisma-client-js"
}

// Connection URL lives in prisma.config.ts (Migrate) and lib/prisma.ts (the
// runtime driver adapter) — Prisma 7 no longer reads it from this block.
datasource db {
  provider = "postgresql"
}

enum ClaimStatus {
  pending
  confirmed
}

// Which project on the site a drop belongs to — Badge (general proof of
// attendance) and Content (hackathon passes) are the same claim/mint
// mechanics under the hood, but browsed and created as separate products.
enum Product {
  badge
  content
}

model Event {
  id              String   @id @default(uuid())
  // Public, human-readable identifier for the claim URL (e.g.
  // "avalanche-summit-afterparty-482917") — the raw uuid `id` above stays
  // the stable internal reference (Postgres FK, on-chain voucher/hasClaimed
  // key), so this can be regenerated or reformatted later without touching
  // anything that actually matters for claim logic.
  slug            String   @unique
  product         Product  @default(badge)
  title           String
  description     String?
  contractAddress String
  // Tx that deployed this drop's own clone contract via EventDropFactory —
  // null for historic rows created before the factory/clone migration.
  deployTxHash    String?
  secretCode      String
  location        String?
  eventEndTime    DateTime
  expiresAt       DateTime
  createdAt       DateTime @default(now())
  imageUrl        String?
  maxSupply       Int?
  // Denormalized so the maxSupply gate can be enforced with a single atomic
  // conditional UPDATE (claimedCount = claimedCount + 1 WHERE claimedCount <
  // maxSupply) instead of a separate COUNT query racing the reservation.
  claimedCount    Int      @default(0)
  ownerAddress    String

  claims Claim[]

  @@index([ownerAddress])
}

// A community on Content — anyone signed in with a wallet can create one,
// and anyone can then make a member card (CheckIn) in it.
model Community {
  id           String    @id @default(uuid())
  slug         String    @unique
  name         String
  description  String?
  // Square logo, client-compressed data: URI (same pipeline as badge art).
  imageUrl     String?
  // ID card template colors (#rrggbb). The layout is fixed for every
  // community; only these change — like a school ID restyled each year.
  cardColor    String    @default("#ffffff")
  accentColor  String    @default("#e0101e")
  // "Date of issue" printed on every member card; null falls back to the
  // date each member made their card.
  issueDate    DateTime?
  // Creator's lowercased wallet — null only for the original Team1 Thailand
  // wall, which predates communities.
  ownerAddress String?
  createdAt    DateTime  @default(now())

  members CheckIn[]

  @@index([ownerAddress])
}

// A community member card: name, X handle and optional profile picture, no
// wallet involved.
model CheckIn {
  id          String    @id @default(uuid())
  // Defaults to the original Team1 Thailand community (seeded by the
  // add_communities migration) so rows created before communities existed —
  // and any deploy still running the old single-wall code — land there.
  communityId String    @default("team1-thailand")
  name        String
  // Normalized (no leading "@", lowercased) so the same person can't join
  // the same community twice under different casing.
  xHandle     String
  avatarUrl   String?
  // Optional title shown on the ID card (e.g. "Builder", "Speaker");
  // the card falls back to "Member".
  role        String?
  createdAt   DateTime  @default(now())

  community Community @relation(fields: [communityId], references: [id], onDelete: Cascade)

  @@unique([communityId, xHandle])
  @@index([communityId])
  @@index([createdAt])
}

model Claim {
  id            String      @id @default(uuid())
  eventId       String
  walletAddress String
  status        ClaimStatus
  txHash        String?
  tokenId       String?
  reservedAt    DateTime    @default(now())
  claimedAt     DateTime?

  event Event @relation(fields: [eventId], references: [id], onDelete: Cascade)

  // One live claim per wallet per event — enforced by the database, not just
  // application logic, so it holds even across multiple server instances.
  @@unique([eventId, walletAddress])
  @@index([eventId])
  @@index([walletAddress])
  @@index([txHash])
}

// Per-wallet profile: a display name the owner can set and change, plus an
// optional X handle that links the wallet to its Content member card (check-
// ins have no wallet of their own) for leaderboard scoring.
model Profile {
  // Lowercased 0x address — matches Claim.walletAddress normalization.
  address     String   @id
  displayName String?
  // Normalized like CheckIn.xHandle (no "@", lowercased). Unique so a member
  // card can only ever be credited to one wallet.
  xHandle     String?  @unique
  updatedAt   DateTime @updatedAt
}
